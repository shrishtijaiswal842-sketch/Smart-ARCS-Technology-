{
  "enabled": true,
  "name": "ARCS Telemetry & Safety Guardrail Validator",
  "description": "Automatically validates simulated sensor bounds (temperature, pressure, HCl gas index) and verifies Demonstration Mode banners whenever dashboard code changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.html",
      "*.js",
      "*.css"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Verify that all modified telemetry ranges remain within A.R.C.S. engineering steering rules (R201 core 480-780C, pressure 1.01-1.35 bar, HCl gas index spike override >= 0.25) and confirm the DEMONSTRATION MODE disclaimer remains visible."
  }
}
